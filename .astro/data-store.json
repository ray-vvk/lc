isicing elit. Hic labore sunt\r\n        rerum commodi minus nemo quas libero quam, esse autem.\r\n      \u003C/p>\r\n    \u003C/Fragment>\r\n    \u003CFragment slot={\"aside-contents\"}>\r\n      \u003CArticleImage\r\n        figSrc={owl}\r\n        figCaptionComponent={() => \u003Cspan>hello??? \u003Cstrong>please\u003C/strong> work.\u003C/span>} \r\n        figAlt=\"owl\"\r\n      />\r\n      {/* need to figure out how to get the figcaption to display correctly. */}\r\n      \u003Cp>\r\n        This is the aside. On large screens, it's off to the right. On small\r\n        screens, it goes below the main part.\r\n      \u003C/p>\r\n    \u003C/Fragment>\r\n  \u003C/SectionWithAside>\r\n\u003CSectionBasic h2=\"another basic section\">\r\n\u003CArticleTable>\r\n\u003CFragment slot=\"thead-contents\">\r\n\u003Ctr>\r\n\u003Cth>abc\u003C/th>\r\n\u003Cth>abc\u003C/th>\r\n\u003Cth>abc\u003C/th>\r\n\u003Cth>abc\u003C/th>\r\n\u003Cth>abc\u003C/th>\r\n\u003Cth>abc\u003C/th>\r\n\u003C/tr>\r\n\u003C/Fragment>\r\n\u003CFragment slot=\"tbody-contents\">\r\n\u003Ctr>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003C/tr>\r\n\u003Ctr>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003C/tr>\r\n\u003Ctr>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003C/tr>\r\n\u003Ctr>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003Ctd>hi\u003C/td>\r\n\u003C/tr>\r\n\u003C/Fragment>\r\n\u003C/ArticleTable>\r\n\u003C/SectionBasic>\r\n\u003CSectionReferences>\r\n\u003C/SectionReferences>\r\n\r\n\r\n\u003C/ArticleLayout>","src/data/article-data/article3.mdx","34d052738bd07ded",true,"meta::meta",[