---
import GlobalLayout from "../layouts/global-layout.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import { getCollection } from "astro:content";
import CardsLinks from "../components/cards-links.astro";
import CardLink from "../components/card-link.astro";
import RandomCta from "../components/cta/random-cta.astro";
const articleData = await getCollection("articleData");
const tagData = await getCollection("tagData");
---

<GlobalLayout>
  <main>
    <section class="hero">
      <div class="background-holder">
        <h1>Knowledge Center</h1>
      </div>
      <p>
        Browse a collection of articles authored, edited, organized, and
        produced by the team at Virovek.
      </p>
    </section>
    <section class="beneath">
      <div class="wrap">
        <div class="browse-articles-btn-div">
          <a href="/lc/articles">
            <button class="btn primary browse-articles-btn"
              >Browse articles →</button
            >
          </a>
        </div>

        <hr />

        <h2>Tags:</h2>
        <CardsLinks>
          {
            tagData.map((tag) => {
              const tagNamePretty = tag.data.name.replaceAll("-", " ");
              return (
                <CardLink
                  cardTitle={<span class="capitalize">{tagNamePretty}</span>}
                  link={`/lc/tags/${tag.id}`}
                >
                  {tag.data.description
                    ? tag.data.description
                    : "Tag description goes here eventually."}
                </CardLink>
              );
            })
          }
        </CardsLinks>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <RandomCta />
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>Recent articles:</p>
        <ul>
          {
            // sort by recent pubDate first. so oldest pubDate last.
            articleData
              .sort((a, b) => {
                if (a.data.pubDate < b.data.pubDate) return 1;
                if (a.data.pubDate > b.data.pubDate) return -1;
                return 0;
              })
              .map((article) => {
                return (
                  <li>
                    <a href={`/lc/articles/${article.id}`}>
                      {article.data.title}
                    </a>
                  </li>
                );
              })
          }
        </ul>
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />

<style>
  body {
    background-color: var(--pale);
  }
  main {
    min-height: 80vh;
  }
  section {
    min-height: 30rem;
    border: none;
    background-color: var(--pale);
  }
  .hero {
    background-color: var(--cyan);
    padding: 4rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    clip-path: ellipse(2000px 400px at 50% 20%);
    .background-holder {
      background-image: url("/lc/liquid4.jpg");
      background-repeat: no-repeat;
      background-position: 10% 0%;
      background-clip: text;
      background-size: 120%;
    }
    h1 {
      font-size: clamp(8rem, 9vw, 9rem);
      color: transparent;
    }
    p {
      color: var(--dark-blue);
      width: 100%;
    }
  }
  .wrap {
    max-width: 100%;
  }
  .browse-articles-btn {
    margin-bottom: 4rem;
    transition: all 400ms;
    cursor: pointer;
  }
  .browse-articles-btn:hover {
    transform: scale(1.02);
  }
  .browse-articles-btn-div {
    display: flex;
    justify-content: center;
  }
  hr {
    border: none;
    border-top: 2px solid var(--line);
    padding: 2rem 0;
  }
  .beneath {
    padding: 4rem;
    background-color: var(--pale);
  }
  .beneath:nth-child(odd) {
    background-color: var(--cyan);
  }
  .beneath.full {
    padding: 0rem;
  }
  .capitalize {
    text-transform: capitalize;
  }
  ul {
    list-style-type: "—  ";
    padding-left: 2rem;
  }
  @media (max-width: 1000px) {
    .hero {
      h1 {
        font-size: clamp(3.5rem, 15vw, 8rem);
      }
      clip-path: ellipse(1200px 340px at 50% 30%);
    }
  }
  @media (max-width: 850px) {
    .hero {
      padding: 2rem;
      padding-bottom: 3rem;
      clip-path: ellipse(1000px 46vw at 50% 20%);
    }
    section {
      min-height: 20rem;
      padding: 2rem;
    }
    .beneath {
      padding: 2rem;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-bottom: 3rem;
      clip-path: ellipse(500px 50vw at 50% 40%);
    }
  }
</style>
