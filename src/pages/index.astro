---
import GlobalLayout from "../layouts/global-layout.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import { getCollection } from "astro:content";
import CardsLinks from "../components/cards-links.astro";
import CardLink from "../components/card-link.astro";
import Cta1 from "../components/cta/cta1.astro";
import Cta2 from "../components/cta/cta2.astro";
import Cta3 from "../components/cta/cta3.astro";
import RandomCta from "../components/cta/random-cta.astro";
const articleData = await getCollection("articleData");
const tagData = await getCollection("tagData");

let articlesByTag: Record<string, object[]> = {};
articleData.map((article) => {
  const tags = article.data.tags;
  for (let tag of tags) {
    if (Object.keys(articlesByTag).includes(tag)) {
      articlesByTag[tag].push(article);
    } else {
      articlesByTag[tag] = [article];
    }
  }
});
---

<GlobalLayout>
  <main>
    <section class="hero">
      <h1>Knowledge Center</h1>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>
          Browse a collection of articles authored, edited, organized, and
          produced by the team at Virovek.
        </p>
        <CardsLinks>
          {
            Object.entries(articlesByTag).map((x, i) => {
              const [tag, articles] = x;
              const tagObject = tagData.find(
                (tagObject) => tagObject.id === tag,
              );
              const tagDescription = tagObject?.data.description;
              // process the tag name
              const tagNamePretty = tag.replaceAll("-", " ");
              return (
                <CardLink
                  cardTitle={<span class="capitalize">{tagNamePretty}</span>}
                  link={`/lc/tags/${tag}`}
                >
                  {tagDescription
                    ? tagDescription
                    : "Tag description goes here eventually."}
                </CardLink>
              );
            })
          }
        </CardsLinks>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <RandomCta />
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>Recent articles:</p>
        <ul>
          {
            // sort by recent pubDate first. so oldest pubDate last.
            articleData
            .sort((a, b) => {
              if (a.data.pubDate < b.data.pubDate) return 1;
              if (a.data.pubDate > b.data.pubDate) return -1;
              return 0;
            })
            .map((article) => {
              return (
                <li>
                  <a href={`lc/articles/${article.id}`}>{article.data.title}</a>
                </li>
              );
            })
          }
          </ul>
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />

<style>
  body {
    background-color: var(--pale);
  }
  main {
    min-height: 80vh;
  }
  section {
    min-height: 30rem;
    border: none;
    background-color: var(--pale);
  }
  .hero {
    background-color: var(--cyan);
    padding: 4rem;
    text-align: center;
    display: flex;
    justify-content: center;
    clip-path: ellipse(2000px 350px at 50% 30%);
    h1 {
      font-size: clamp(10rem, 9vw, 12rem);
    }
  }
  .wrap {
    max-width: 100%;
  }
  .beneath {
    padding: 4rem;
    background-color: var(--pale);
  }
  .beneath:nth-child(odd) {
    background-color: var(--cyan);
  }
  .beneath.full {
    padding: 0rem;
  }
  .capitalize {
    text-transform: capitalize;
  }
  ul {
    list-style-type: "—  ";
    padding-left: 2rem;
  }
  @media (max-width: 1000px) {
    .hero {
      h1 {
        font-size: clamp(3.5rem, 15vw, 8rem);
      }
    }
  }
</style>
