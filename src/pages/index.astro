---
import GlobalLayout from "../layouts/global-layout.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import ArticleCard from "../components/article/article-card.astro";
import ArticleCards from "../components/article/article-cards.astro";
---

<GlobalLayout>
  <main>
    <section class="hero">
      <div class="wrap">
        <p>
          This will be the homepage. It'll look less ugly later. I haven't
          worked on it at all yet.
        </p>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>A list of articles and their categories will go here. For now, it's just a couple cards linking to articles.</p>
        <ArticleCards>
          <ArticleCard cardTitle="Article 1">
            <a href="/lc/articles/article1">Article 1</a>
          </ArticleCard>
          <ArticleCard cardTitle="Article 2">
            <a href="/lc/articles/article2">Article 2</a>
          </ArticleCard>
        </ArticleCards>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>Something else will go here. Probably a call to action. I haven't decided.</p>
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />

<style>
  main {
    min-height: 80vh;
  }
  section {
    height: 30rem;
    border: none;
  }
  .hero {
    background-color: var(--cyan);
    padding: 4rem;
  }
  .beneath {
    padding: 4rem;
    background-color: var(--pale);
  }
  .beneath:nth-child(odd) {
    background-color: var(--cyan);
  }
</style>
