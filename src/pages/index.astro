---
import GlobalLayout from "../layouts/global-layout.astro";
import GlobalStyles from "../styles/global-styles.astro";
import { getCollection } from "astro:content";
import CardsLinks from "../components/cards-links.astro";
import CardLink from "../components/card-link.astro";
import RandomCta from "../components/cta/random-cta.astro";
import RecentArticles from "../components/recent-articles.astro";
import OrdinaryPageStyles from "../styles/ordinary-page-styles.astro";
const articleData = await getCollection("articleData");
const tagData = await getCollection("tagData");
---

<GlobalLayout titlePart="Home">
  <main>
    <section class="hero">
      <div class="background-holder">
        <h1>Knowledge Center</h1>
      </div>
      <p>
        Browse a collection of articles authored, edited, organized, and
        produced by the team at Virovek.
      </p>
    </section>
    <section class="beneath">
      <div class="wrap">
        <div class="btn-shelf">
          <a href="/lc/articles">
            <button class="btn primary"
              >Browse all articles →</button
            >
          </a>
          <a href="/lc/publications">
            <button class="btn primary"
              >View publications →</button
            >
          </a>
        </div>

        <div class="small-blurb">
          <hr />
          <p>
            Welcome to Virovek's knowledge center. This is a repository of
            articles produced by the Virovek team. Here, you'll be able to find
            product notes, documentation, scientific reviews, production service
            descriptions, technical specifications, and more.
          </p>
          <hr />
        </div>

        <h2>Tags:</h2>
        <CardsLinks>
          {
            tagData.map((tag) => {
              const tagNamePretty = tag.data.name.replaceAll("-", " ");
              return (
                <CardLink
                  cardTitle={<span class="capitalize">{tagNamePretty}</span>}
                  link={`/lc/tags/${tag.id}`}
                >
                  {tag.data.description
                    ? tag.data.description
                    : "Tag description goes here eventually."}
                </CardLink>
              );
            })
          }
        </CardsLinks>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <RandomCta />
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <RecentArticles maxArticles={10} />
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />
<OrdinaryPageStyles />

<style>
  .hero {
    background-color: var(--cyan);
    padding: 4rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    clip-path: ellipse(2000px 400px at 50% 20%);
    .background-holder {
      background-image: url("/lc/liquid5.jpg");
      background-repeat: no-repeat;
      background-position: 10% 0%;
      background-clip: text;
      background-size: 120%;
    }
    h1 {
      font-size: clamp(8rem, 9vw, 9rem);
      color: transparent;
    }
    p {
      color: var(--dark-blue);
      width: 100%;
    }
  }
  .btn-shelf {
    button {
      transition: all 400ms;
      cursor: pointer;
      font-size: 1.1rem;
      padding: 1.1rem 1.6rem;
    }
    button:hover {
      transform: scale(1.02);
    }
    display: flex;
    justify-content: center;
    padding-bottom: 3rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .small-blurb {
    p {
      padding: 2rem 0;
      text-align: center;
    }
    padding-bottom: 4rem;
  }

  .capitalize {
    text-transform: capitalize;
  }
  @media (max-width: 1000px) {
    .hero {
      h1 {
        font-size: clamp(3.5rem, 15vw, 8rem);
      }
      clip-path: ellipse(1200px 340px at 50% 30%);
    }
  }
  @media (max-width: 850px) {
    .hero {
      padding: 2rem;
      padding-bottom: 3rem;
      clip-path: ellipse(1000px 46vw at 50% 20%);
    }
    section {
      min-height: 20rem;
      padding: 2rem;
    }
    .beneath {
      padding: 2rem;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-bottom: 3rem;
      clip-path: ellipse(500px 50vw at 50% 40%);
    }
  }
</style>
