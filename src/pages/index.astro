---
import GlobalLayout from "../layouts/global-layout.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import ArticleCard from "../components/article/article-card.astro";
import ArticleCards from "../components/article/article-cards.astro";
import { getCollection } from "astro:content";
import CardsLinks from "../components/cards-links.astro";
import CardLink from "../components/card-link.astro";
const articleData = await getCollection("articleData");
---

<GlobalLayout>
  <main>
    <section class="hero">
      <h1>Knowledge Center</h1>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>
          Browse a collection of articles authored, edited, organized, and
          produced by the team at Virovek.
        </p>
        <CardsLinks>
          {
            articleData.map((article) => {
              return (
                <CardLink cardTitle={article.data.title} link={article.data.slug}>
                  <p>Published: {article.data.pubDate}</p>
                </CardLink>
              );
            })
          }
        </CardsLinks>
      </div>
    </section>
    <section class="beneath">
      <div class="wrap">
        <p>
          Something else will go here. Probably a call to action. I haven't
          decided.
        </p>
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />

<style>
  body {
    background-color: var(--pale);
  }
  main {
    min-height: 80vh;
  }
  section {
    min-height: 30rem;
    border: none;
    background-color: var(--pale);
  }
  .hero {
    background-color: var(--cyan);
    padding: 4rem;
    text-align: center;
    display: flex;
    justify-content: center;
    clip-path: ellipse(2000px 350px at 50% 30%);
    h1 {
      font-size: clamp(10rem, 9vw, 12rem);
    }
  }
  .wrap {
    max-width: 100%;
  }
  .beneath {
    padding: 4rem;
    background-color: var(--pale);
  }
  .beneath:nth-child(odd) {
    background-color: var(--cyan);
  }
  @media (max-width: 1000px) {
    .hero {
      h1 {
        font-size: clamp(3.5rem, 15vw, 8rem);
      }
    }
  }
</style>
