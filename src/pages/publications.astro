---
import GlobalStyles from "../styles/global-styles.astro";
import GlobalLayout from "../layouts/global-layout.astro";
import RandomCta from "../components/cta/random-cta.astro";
import OrdinaryPageStyles from "../styles/ordinary-page-styles.astro";
import Publications from "../components/publications/publications.astro";
---

<meta
  name="description"
  content="Virovek is cited in nearly 400 studies, journal articles, and conference presentations across 15 years. Browse a selection of them here."
/>

<GlobalLayout titlePart="Publications">
  <main>
    <section class="">
      <div class="wrap">
        <h1>Publications</h1>
        <p class="lead">
          Virovek is cited in nearly 400 studies, journal articles, and
          conference presentations across 15 years.
        </p>
        <h2>Selected works</h2>
        <div id="refresh-button-holder">
          <button id="refresh"><div id="arrow">↻</div></button>
        </div>
        <div>
          <Publications count={30} />
        </div>
      </div>
    </section>
    <section class="beneath cta-section">
      <div class="wrap">
        <RandomCta />
      </div>
    </section>
  </main>
</GlobalLayout>
<GlobalStyles />
<OrdinaryPageStyles />

<script>
  const refreshBtn = document.getElementById("refresh") as HTMLButtonElement;
  refreshBtn.addEventListener("click", (e) => {
    window.location.reload();
  });
</script>

<style>
  h2 {
    padding: 2rem 0 1rem 0;
    display: inline-block;
  }
  #refresh-button-holder {
    display: inline-block;
    vertical-align: central;
  }
  #refresh {
    /* border: none; */
    border-radius: 0.3rem;
    background-color: var(--pale);
    margin-left: 2rem;
    font-size: 2rem;
    transition-duration: 200ms;
    color: var(--ink);
    height: 3rem;
    width: 3rem;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #arrow {
    font-size: 1.5rem;
    height: 2rem;
    width: 2rem;
  }
  /* #refresh:hover {
    color: #4f4f4f;
  } */
  .cta-section {
    background-color: var(--cyan);
  }
  @media (max-width: 850px) {
    #refresh-button-holder {
      vertical-align: unset;
    }
  }
</style>
