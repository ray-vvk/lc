---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/article-layout.astro";
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const articles = await getCollection("articleData");
  return articles.map((article) => {
    return {
      params: { id: article.id },
      props: { article },
    };
  });
}
// 2. For your template, you can get the entry directly from the prop
const { article } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout articleTitle={article.data.title} articleSubtitle={article.data.subtitle ?? ""} articleAuthor={article.data.author} articleTags={article.data.tags} articlePubDate={article.data.pubDate.toISOString()} articleUpdateDate={article.data.updatedDate.toISOString()} articleKeywords={article.data.keywords}>  
  <Content />
</ArticleLayout>
