---
interface Props {
  titlePart: string;
}
const { titlePart } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titlePart} | Virovek Knowledge Center</title>
  <meta
    name="description"
    content="Virovek's Knowledge Center contains protocols, documentation, application notes, reports, scientific review articles, and more."
  />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="icon" type="image/png" href="/virovek-favicon.png" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P3ZTDSDBL4"
  ></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-P3ZTDSDBL4");
  </script>
  
</head>
