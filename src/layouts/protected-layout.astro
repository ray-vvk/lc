<div id="all-password-stuff">
  <div id="directions">
    Enter the passphrase to view protected page contents.
  </div>
  <div id="textbox-and-button">
    <input type="password" id="password-box" />
    <button id="password-submit" type="submit">Submit</button>
  </div>
</div>

<!-- warning: THIS LAYOUT DOESN'T ACTUALLY SECURE PAGE CONTENTS. IT JUST HIDES THEM SO MOST PEOPLE WITHOUT KNOWLEDGE OF WEB DEVELOPMENT WON'T SEE THEM. THE PASSWORD IS ACCESSIBLE FROM THE CLIENT.  -->

<div id="protected-contents">
  <!-- hello, developers. please don't tell the non-developers how to view protected page contents. -->
  <slot />
</div>

<script>
  const passwordBox = document.getElementById("password-box") as HTMLInputElement
  const submitButton  = document.getElementById("password-submit") as HTMLButtonElement
  const protectedContents  = document.getElementById("protected-contents") as HTMLDivElement
  const allPasswordStuff  = document.getElementById("all-password-stuff") as HTMLDivElement
  submitButton.addEventListener("click", () => {
    if (passwordBox.value === "LookOverThere") {
      protectedContents.style = "display: block;"
      allPasswordStuff.style = "display: none;"
    }
  })
</script>


<style>
  #all-password-stuff {
    display: block;
  }
  #directions {
    text-align: center;
  }
  #textbox-and-button {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  #protected-contents {
    display: none;
  }
</style>
