---
import ArticleHeader from "../components/article/article-header.astro";
import GlobalLayout from "./global-layout.astro";
interface Props {
  articleTitle: string;
  articleSubtitle: string;
  // articleCategory: string;
  articleAuthor: string;
  articleTags: string[];
  articlePubDate: string;
  articleUpdateDate: string;
  articleKeywords?: string[];
}
const {
  articleTitle,
  articleSubtitle,
  articleAuthor,
  articleTags,
  articlePubDate,
  articleUpdateDate,
  articleKeywords,
} = Astro.props;
// STILL TODO: SEO the heck out of these articles. the head meta tags gotta be automatically individualized per article. 
---

<Fragment>
  <title>{articleTitle} | Virovek Knowledge Center</title>
  <meta name="description" content="description text goes here!!!!" />

  <!-- Replace with the final production URL before publishing -->
  <link
    rel="canonical"
    href="https://virovek.com/resources/fluorescent-capsid-labeled-aav-vs-gfp/"
  />

  <meta property="og:type" content="article" />
  <meta property="og:title" content="article title goes here!!!! " />
  <meta property="og:description" content="description text goes here!!!!" />
  <meta property="og:url" content="article's real url goes here!!!!" />
  <!-- <meta
  property="og:image"
  content="hero image url goes here!!!! if it exists."
  /> -->
</Fragment>

<GlobalLayout>
  <ArticleHeader
    title={articleTitle}
    subtitle={articleSubtitle}
    author={articleAuthor}
    tags={articleTags}
    pubDate={articlePubDate}
    updatedDate={articleUpdateDate}
    keywords={articleKeywords}
  />
  <main>
    <slot />
  </main>
</GlobalLayout>

