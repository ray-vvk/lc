---
import ArticleHeader from "../components/article/article-header.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import GlobalLayout from "./global-layout.astro";
interface Props {
  articleTitle: HTMLElement | string;
  articleSubtitle: HTMLElement | string;
  articleCategory: HTMLElement | string;
}
const { articleTitle, articleSubtitle, articleCategory } = Astro.props;
---

<GlobalLayout>
  <ArticleHeader
    category={articleCategory}
    subtitle={articleSubtitle}
    title={articleTitle}
  />
  <main>
    <slot />
  </main>
</GlobalLayout>

<GlobalStyles />
