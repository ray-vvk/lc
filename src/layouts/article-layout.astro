---
import ArticleHeader from "../components/article/article-header.astro";
import GlobalStyles from "../components/styles/global-styles.astro";
import GlobalLayout from "./global-layout.astro";
interface Props {
  articleTitle: string;
  articleSubtitle: string;
  // articleCategory: string;
  articleTags: string[];
  articlePubDate: string;
  articleUpdateDate: string;
}
const {
  articleTitle,
  articleSubtitle,
  articleTags,
  articlePubDate,
  articleUpdateDate,
} = Astro.props;
---

<GlobalLayout>
  <ArticleHeader
    subtitle={articleSubtitle}
    title={articleTitle}
    tags={articleTags}
    pubDate={articlePubDate}
    updatedDate={articleUpdateDate}
  />
  <main>
    <slot />
  </main>
</GlobalLayout>

<GlobalStyles />

<style>
  .cta {
    background: linear-gradient(135deg, var(--dark-blue), var(--light-blue));
    color: #fff;
    border-radius: 16px;
    padding: 2rem;
    margin-top: 2rem;
  }

  .cta h2,
  .cta h3 {
    color: #fff;
  }

  .cta a {
    color: #fff;
  }

  .cta .btn.secondary {
    border-color: #fff;
    background: #fff;
    color: var(--dark-blue);
  }
</style>
