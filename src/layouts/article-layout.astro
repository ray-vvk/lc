---
import ArticleHeader from "../components/article/article-header.astro";
import RandomCta from "../components/cta/random-cta.astro";
import GlobalLayout from "./global-layout.astro";
interface Props {
  articleTitle: string;
  articleSubtitle: string;
  // articleCategory: string;
  articleAuthor: string;
  articleTags: string[];
  articlePubDate: string;
  articleUpdateDate: string;
  articleKeywords?: string[];
  articleId: string;
}
const {
  articleTitle,
  articleSubtitle,
  articleAuthor,
  articleTags,
  articlePubDate,
  articleUpdateDate,
  articleKeywords,
  articleId,
} = Astro.props;
let categoriesStringForMetaDescription = "";
articleTags.forEach((tag, i, tags) =>
  i === tags.length - 1
    ? (categoriesStringForMetaDescription += tag)
    : (categoriesStringForMetaDescription += `${tag}, `),
);
const description = `Article authored by ${articleAuthor}. Published ${articlePubDate.slice(0, 10)}. Categorized under ${categoriesStringForMetaDescription}.`;
const realUrl = `https://kc.virovek.com/articles/${articleId}`;
---

<Fragment>
  <title>{articleTitle} | Virovek Knowledge Center</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={realUrl} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={`${articleTitle}`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={realUrl} />
  <meta
    property="og:image"
    content="https://kc.virovek.com/virovek-favicon.png"
  />
  <meta property="article:author" content={articleAuthor} />
  <meta property="article:published_time" content={articlePubDate} />
  <meta property="article:modified_time" content={articleUpdateDate} />
  {
    articleKeywords
      ? articleKeywords.map((kw) => (
          <meta property="article:tag" content={kw} />
        ))
      : null
  }
  {
    articleTags
      ? articleTags.map((tag) => <meta property="article:tag" content={tag} />)
      : null
  }
</Fragment>

<GlobalLayout>
  <ArticleHeader
    title={articleTitle}
    subtitle={articleSubtitle}
    author={articleAuthor}
    tags={articleTags}
    pubDate={articlePubDate}
    updatedDate={articleUpdateDate}
    keywords={articleKeywords}
  />
  <main>
    <slot />
  </main>
  <section class="cta-section">
    <div class="wrap">
      <RandomCta />
    </div>
  </section>
</GlobalLayout>

<style>
  .cta-section {
    padding: 0 4rem 8rem 4rem;
  }
  .wrap {
    max-width: 100%;
  }
  @media (max-width: 850px) {
    .cta-section {
      padding: 0 2rem 4rem 2rem;
    }
  }
  @media (max-width: 600px) {
    main {
      p {
        font-size: 1rem;
      }
    }
  }
</style>
<style is:global>
  /* q: why does this h2 rule only get applied when this style block is made global with the is:global attribute? */
  /* a: if it's not global, it will only get applied to h2's that have a [data-astro-cid-abcdexyz] attribute or similar (scoped to this component!), and none of the h2's in the article have that because they're being pasted in as children from elsewhere (the article data). */
  h2 {
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-family: Roboto, Helvetica, Arial, sans-serif;
  }
</style>
