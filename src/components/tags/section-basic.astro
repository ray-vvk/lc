---
interface Props {
  h2: string;
}
const { h2 } = Astro.props;
---

<section>
  <div class="wrap">
    <div class="h2-and-sort">
      <div>
        <h2>{h2}</h2>
      </div>
      <div>
        <label for="sort-articles"></label>
        <select name="articles" id="sort-articles">
          <option value="alphabetical" selected>Alphabetical</option>
          <option value="pubDate">Date published</option>
        </select>
      </div>
    </div>
    <slot />
  </div>
</section>

<script>
import { articleSortType } from "../../store"
  document.getElementById("sort-articles")?.addEventListener('change', (e) => {
    // @ts-ignore
    articleSortType.set(e.target.value)
  })

</script>

<style>
  h2 {
    text-transform: capitalize;
    display: inline-block;
  }
  .h2-and-sort {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  select {
    padding: 0.4rem;
  }
  @media (max-width: 850px) {
    .h2-and-sort {
      display: inline-block;
    }
  }
</style>
