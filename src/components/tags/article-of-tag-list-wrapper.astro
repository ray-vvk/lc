---
import { getCollection } from "astro:content";
import ArticleOfTagList from "./article-of-tag-list";
import { articleSearchDisplaySimple } from "../../store";
import ArticleSimpleTogglerScript from "./article-simple-toggler-script.astro"
interface Props {
  tag: string;
}
const { tag } = Astro.props;
// i was passed the tag from the mdx page, it was the page's name. "full-stack development"
// i need to turn all spaces into hyphens.
const tagHyphenated = tag.replaceAll(" ", "-");
const articleData = await getCollection("articleData");
const articlesOfTag = articleData.filter((article) =>
  article.data.tags.includes(tagHyphenated.toLowerCase()),
);
---

<div>
  <div class="toggle-holder">
    <label
      >Toggle simple view: <input
        type="checkbox"
        id="toggler"
        checked={articleSearchDisplaySimple.get()}
      /></label
    >
  </div>
  <div class="list-holder">
    <ArticleOfTagList client:load articlesOfTag={articlesOfTag} />
  </div>
</div>

<ArticleSimpleTogglerScript />

<style>
  .toggle-holder {
    font-size: 0.9rem;
  }
  .list-holder {
    padding: 1rem 0;
  }
</style>
