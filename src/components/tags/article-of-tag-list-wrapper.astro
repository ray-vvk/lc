---
import { getCollection } from "astro:content";
import ArticleOfTagList from "./article-of-tag-list";
interface Props {
  tag: string
}
const {tag} = Astro.props
// i was passed the tag from the mdx page, it was the page's name. "full-stack development"
// i need to turn all spaces into hyphens.
const tagHyphenated = tag.replaceAll(" ", "-")
const articleData = await getCollection("articleData")
const articlesOfTag = articleData.map((article) => {
  if (article.data.tags.includes(tagHyphenated.toLowerCase())) {
    return article
  }
});
---

<div>
  <ArticleOfTagList client:load articlesOfTag={articlesOfTag} />
</div>

