---
import { getCollection } from "astro:content";
import ArticleOfTagList from "./article-of-tag-list";
interface Props {
  tag: string
}
const {tag} = Astro.props
const articleData = await getCollection("articleData")
const articlesOfTag = articleData.map((article) => {
  if (article.data.tags.includes(tag.toLowerCase())) {
    return article
  }
});
---

<div>
  <ArticleOfTagList client:load articlesOfTag={articlesOfTag} />
</div>

