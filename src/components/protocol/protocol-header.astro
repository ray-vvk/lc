---
interface Props {
  title: string;
  tags: string[];
  keywords?: string[];
  metadata?: Record<string, string | string[]>
}
const { title, tags, keywords, metadata } =
  Astro.props;
---

<header>
  <div class="wrap">
    <!-- <div class="eyebrow">{category}</div> -->
    <h1>{title}</h1>
    <hr />
    <div class="top-info-table">
      <div class="row">
        <div><strong>Document number: </strong></div>
        <div>{metadata?.document_number || "N/A"}</div>
      </div>
      <div class="row">
        <div><strong>Version: </strong></div>
        <div>{metadata?.version || "N/A"}</div>
      </div>
      <div class="row">
        <div><strong>Status: </strong></div>
        <div>{metadata?.status || "N/A"}</div>
      </div>
    </div>
    <hr />
    <div>
      Description goes here. for now it's: Research use only. Public research protocol aligned by subject with internal Virovek-SOP-019; independently maintained and not a controlled GLP SOP.
    </div>
    <hr />
    <div class="cells-wells">
      HEK293T · HEK293 · HepG2 · RC32  |  96-well plate format
    </div>
    
    <div class="tags">
      Tags: &nbsp;
      {
        tags.map((tag, i, tags) => {
          if (i !== tags.length - 1) {
            return (
              <span>
                <a href={`/tags/${tag}`}>{tag}</a>,&nbsp;
              </span>
            );
          }
          return (
            <span>
              <a href={`/tags/${tag}`}>{tag}</a>
            </span>
          );
        })
      }
    </div>
    <div class="keywords">
      {keywords ? "Keywords: " : null}
      {
        // write keywords with commas until the last one
        keywords
          ? keywords.map((keyword, i, keywords) => {
              return i === keywords.length - 1 ? keyword : `${keyword}, `;
            })
          : null
      }
    </div>
  </div>
</header>

<style>
  h1 {
    font-size: 3rem;
  }
  .top-info-table {
    max-width: 32rem;
    .row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      min-height: max-content;
    }
  }
  .tags {
    font-size: 0.94rem;
    font-weight: bold;
    a {
      text-transform: uppercase;
    }
  }
  .cells-wells {
    margin-bottom: 2rem;
  }
  .keywords {
    padding-top: 1rem;
    font-style: italic;
    font-size: 0.93rem;
    color: var(--muted);
  }
  @media(max-width: 600px) {
    .top-info-table {
      .row {
        display: block;
      }
    }
  }
</style>
