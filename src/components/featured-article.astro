---
import {
  dateFormatLongNumeric,
  adjustPubDate,
} from "../lib/article/article-helper-functions";
import { getCollection } from "astro:content";
const articles = await getCollection("articleData");
// specify an article by id.
const id =
  "in-vivo-car-t-autoimmune-diseases-potential-t-cell-targeted-aav-gene-delivery";
const featuredArticle = articles.find((a) => {
  return a.id === id;
});
---

<div>
  {
    featuredArticle ? (
      <div class="featured-article-border">
        <a href={`/articles/${featuredArticle.id}`} class="clickable-stuff">
          <h3>{featuredArticle.data.title}</h3>
          <h4>{featuredArticle.data.subtitle}</h4>
        </a>
        <div />
        <div>{featuredArticle.data.author}</div>
        <div>
          Published {dateFormatLongNumeric.format(adjustPubDate(featuredArticle.data.pubDate))}{" "}
          in {featuredArticle.data.tags}
        </div>
      </div>
    ) : (
      <div>There are no featured articles at this time. </div>
    )
  }
</div>

<style>
  .featured-article-border {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.2rem;
    background: #fff;
  }
  h3,
  h4 {
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    display: block;
  }
  .clickable-stuff {
    margin-bottom: 1rem;
  }
</style>
