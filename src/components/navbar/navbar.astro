---
import { Image } from "astro:assets";
import vvkLogo from "../../images/Virovek-Logo-Web-300x103.png";
import HamburgerStyles from "../styles/hamburger-styles.astro";
---

<nav class="topbar" id="nav-topbar">
  <div class="wrap">
    <a href="/lc">
      <div class="logo-and-name">
        <div class="virovek-logo-div">
          <Image src={vvkLogo} class="virovek-logo" alt="the virovek logo." />
        </div>
        Knowledge Center
      </div>
    </a>
    <button
      id="hamburger-button"
      class:list={["hamburger hamburger--slider"]}
      type="button"
    >
      <span class="hamburger-box">
        <span class="hamburger-inner"></span>
      </span>
    </button>

    {/* links when desktop (on the navbar) */}
    <div class="links">
      <div>
        <a href="/lc/articles"> Articles</a>
      </div>
      <div>
        <a href="https://store.virovek.com/" target="_blank" rel="noreferrer"
          >Premade Products</a
        >
      </div>
      <div>
        <a
          href="https://store.virovek.com/forms/custom"
          target="_blank"
          rel="noreferrer">Custom AAV Request</a
        >
      </div>
    </div>

    {/* links when mobile (a menu that appears below the navbar) */}
    <div id="mobile-menu" class:list={["links mobile-menu-hidden"]}>
      <div class="wrap">
        <div>
          <a href="/lc/articles"> Articles </a>
        </div>
        <div>
          <a href="https://store.virovek.com/" target="_blank" rel="noreferrer">
            Product Catalog
          </a>
        </div>
        <div>
          <a
            href="https://store.virovek.com/forms/custom"
            target="_blank"
            rel="noreferrer"
          >
            Custom AAV Request
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
<script>
  let hamburgerOpen = false;
  const hamburgerButton = document.getElementById(
    "hamburger-button",
  ) as Element;
  const mobileMenu = document.getElementById("mobile-menu") as Element;
  hamburgerButton.addEventListener("click", () => {
    if (hamburgerOpen) {
      // already open, close it
      // update styles
      hamburgerButton.className = hamburgerButton.className.replace(
        " is-active",
        "",
      );
      mobileMenu.className = mobileMenu.className.replace(
        " mobile-menu",
        " mobile-menu-hidden",
      );
      // set state of menu being open to false
      hamburgerOpen = false;
    } else {
      // open it
      hamburgerButton.className += " is-active";
      mobileMenu.className = mobileMenu.className.replace(
        " mobile-menu-hidden",
        " mobile-menu",
      );
      hamburgerOpen = true;
    }
  });

  const navTopbar = document.getElementById("nav-topbar") as Element; // assert it must be there!
  const ro = new ResizeObserver((observedElements) => {
    for (const element of observedElements) {
      const cr = element.contentRect;
      if (cr.width >= 850 && hamburgerOpen) {
        // if width is ever greater than 850 and the mobile menu is open, force close it which also reverts navbar styles to desktop.
        hamburgerOpen = false;
        mobileMenu.className = mobileMenu.className.replace(
          " mobile-menu",
          " mobile-menu-hidden",
        );
        hamburgerButton.className = hamburgerButton.className.replace(
          " is-active",
          "",
        );
      }
    }
  });

  ro.observe(navTopbar);
</script>
<HamburgerStyles />

<style>
  .topbar {
    background: var(--dark-blue);
    color: #fff;
    padding: 0.65rem 0;
    font-size: 0.93rem;
    height: 4rem;

    .logo-and-name {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .virovek-logo-div {
      width: 7rem;
    }

    .wrap {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      height: 100%;

      .links {
        display: flex;
        gap: 2rem;
      }
    }

    .links.mobile-menu-hidden {
      display: none;
    }

    a {
      color: #fff;
      text-decoration: none;
    }
  }

  @media (max-width: 850px) {
    .topbar {
      position: relative;
    }

    .topbar .wrap {
      .links {
        display: none;
      }

      .links.mobile-menu {
        display: block;
        position: absolute;
        top: 4rem;
        left: 0;
        background-color: var(--dark-blue);
        width: 100%;
        padding-bottom: 2rem;
        text-align: right;
        z-index: 1;

        .wrap {
          display: block;
        }
      }

      .links.mobile-menu-hidden {
        display: none;
      }
    }
  }
</style>
