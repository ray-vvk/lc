---
interface Props {
  cardTitle?: string;
  cardTitleComponent?: HTMLElement | (() => HTMLElement);
  link: string;
}
const { cardTitle, cardTitleComponent, link } = Astro.props;
---

<a href={link}>
  <div class="card">
    <h3>{(() => {
      if (cardTitleComponent) {
        if (typeof cardTitleComponent === "function") {
          return cardTitleComponent() 
        }
        return cardTitleComponent
      }
      if (cardTitle) {
        return cardTitle
      }
    })()}</h3>
    <slot />
  </div>
</a>

<style>
  a {
    display: inline-block;
    text-decoration: none;
    transition: all 300ms;
    p {
      color: var(--ink);
    }
  }
  a:hover {
    transform: scale(1.02);
  }
</style>
