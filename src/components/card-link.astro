---
interface Props {
  cardTitle: HTMLElement | (() => HTMLElement) | string;
  link: string;
}
const { cardTitle, link } = Astro.props;
let cardTitle_;
if (typeof cardTitle === "function") {
  cardTitle_ = cardTitle();
} else {
  cardTitle_ = cardTitle;
}
---

<a href={link}>
  <div class="card">
    <h3>{cardTitle_}</h3>
    <slot />
  </div>
</a>

<style>
  a {
    display: inline-block;
    text-decoration: none;
    transition: all 300ms;
    p {
      color: var(--ink);
    }
  }
  a:hover {
    transform: scale(1.02);
  }
</style>
