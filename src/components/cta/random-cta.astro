---
import Cta1 from "./cta1.astro";
import Cta2 from "./cta2.astro";
import Cta3 from "./cta3.astro";
---

<div id="cta-goes-here">
  <Cta1 />
  <Cta2 />
  <Cta3 />
</div>

<script>
  // render all CTAs above, remove all but the one that's selected

  // random
  // const ctaGoesHere = document.getElementById("cta-goes-here");
  // const lower = 1;
  // const upper = 3; // change this to be the number of CTAs you got
  // const selection = Math.floor(Math.random() * upper) + lower;
  
  // time-based
  const currentTimeMinutes = (new Date()).getMinutes()
  const currentTimeSeconds = (new Date()).getSeconds()
  const changeEveryXSeconds = 20
  const numberOfCtas = 3
  const secondsBeforeRepeating = changeEveryXSeconds * numberOfCtas
  const currentTimeMinutesAndSecondsInSeconds = currentTimeMinutes * 60 + currentTimeSeconds
  const timeDividedIntoWindows = (currentTimeMinutesAndSecondsInSeconds) % secondsBeforeRepeating
  const selection = Math.floor(timeDividedIntoWindows/changeEveryXSeconds) + 1
  // selection was gonna be a number 0 through numberOfCtas-1, needed to add 1 to it 

  const ctaGoesHere = document.getElementById("cta-goes-here");
  const ctaList = ctaGoesHere?.querySelectorAll(".cta");
  if (ctaList) {
    ctaList.forEach((cta, i) => {
      if (i + 1 !== selection) {
        cta.remove();
      }
    });
  }

  // AAAAAAAAAHHHHHH ASTRO COMPONENT PURE TS THE FUNCTIONALITY THAT I WANTED RAAAAAAAAAAAAAAHHHH
</script>
