<style>
  .cta {
    background: linear-gradient(135deg, var(--dark-blue), var(--light-blue));
    color: #fff;
    border-radius: 16px;
    padding: 2rem;
    margin-top: 2rem;
  }

  .cta h2,
  .cta h3 {
    color: #fff;
  }

  .cta a {
    color: #fff;
  }

  .cta .btn.secondary {
    border-color: #fff;
    background: #fff;
    color: var(--dark-blue);
  }

  @media (max-width: 850px) {
    .btn {
      padding: 0.5rem 0.9rem;
      font-size: 1.05rem;
    }
  }
</style>
