---
import { Image } from "astro:assets";
import { determineImgSrc } from "./author-image-functions";
interface Props {
  authorName: string;
}
const { authorName } = Astro.props;
let imgSrc = null;
imgSrc = determineImgSrc(authorName)
---

<div class="image-holder"><Image src={imgSrc} alt={`image of author: ${authorName}`} /></div>

<style>
  .image-holder {
    width: 4rem;
    height: 4rem;
    border-radius: 9999rem;
    overflow: hidden;
    border: 1px solid var(--ink);
  }
</style>