---
import { Image } from "astro:assets";
import haifeng from "./images/haifeng.jpg";
import ray from "./images/ray.jpg";
import unknown from "./images/unknown.jpg";
interface Props {
  authorName: string;
}
const { authorName } = Astro.props;
let imgSrc = null;
switch (authorName) {
  case "haifeng chen":
    imgSrc = haifeng;
    break;
  case "ray":
    imgSrc = ray;
    break;
  default:
    imgSrc = unknown;
    break;
}
---

<div class="image-holder"><Image src={imgSrc} alt={`image of author: ${authorName}`} /></div>

<style>
  .image-holder {
    width: 4rem;
    height: 4rem;
    border-radius: 9999rem;
    overflow: hidden;
    border: 1px solid var(--ink);
  }
</style>