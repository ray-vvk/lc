---
interface Props {
  nums: string;
}
const { nums } = Astro.props;
// the idea: take a string of numbers and commas. 1,2,5,9 or a single number. break it down and render links to the references section below to each li with id reference-#
let numsList: string[];
if (nums.includes(",")) {
  numsList = nums.split(",");
} else {
  numsList = [nums];
}
const superscriptSymbols = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];
const outputList: [number, string][] = []; // [number, superscript symbol of number]
for (let i = 0; i < numsList.length; i++) {
  const citationNumString = numsList[i];
  if (citationNumString.length === 2) {
    // if 2 digits long. i don't ever anticipate the references getting into the 3 digits.
    const first = superscriptSymbols[Number(citationNumString[0])];
    const second = superscriptSymbols[Number(citationNumString[1])];
    outputList.push([Number(citationNumString), `${first}${second}`]);
  } else {
    outputList.push([
      Number(citationNumString),
      superscriptSymbols[Number(citationNumString)],
    ]);
  }
}
---

<span>
  {
    outputList.map(([num, symbol], i) => {
      if (i < outputList.length - 1) {
        return (
          <Fragment>
            <>
              <a href={`#reference-${num}`}>{symbol}</a>
              <sup>,</sup>
            </>
          </Fragment>
        );
      }
      return (
        <Fragment>
          <a href={`#reference-${num}`}>{symbol}</a>
        </Fragment>
      );
    })
  }
</span>

<style>
  a {
    text-decoration: none;
  }
</style>
