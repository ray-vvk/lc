---
import { getCollection } from "astro:content";
import ArticleSearchList from "./article-search-list";
import ArticleSearchBar from "./article-search-bar";
import { articleSearchDisplaySimple } from "../../store";
import ArticleSimpleTogglerScript from "../tags/article-simple-toggler-script.astro";
import { sortRecentFirst } from "../../lib/article/article-helper-functions";

const articleData = sortRecentFirst(await getCollection("articleData"));
---

<div class="all-holder">
  <div class="search-bar-holder">
    Search for an article by title, url, tags, or keywords: <ArticleSearchBar
      client:load
    />
  </div>
  <div class="describing-limits">
    Search results are limited to a maximum of 30 articles.
  </div>
  <div class="toggle-holder">
    <label
      >Toggle simple view: <input
        type="checkbox"
        id="toggler"
        checked={articleSearchDisplaySimple.get()}
      /></label
    >
  </div>
  <div class="list-holder">
    <ArticleSearchList client:load articleData={articleData} maxArticles={30} />
  </div>
</div>

<ArticleSimpleTogglerScript />

<script>
  const searchBar = document.getElementById(
    "article-search-bar",
  ) as HTMLInputElement;
  searchBar.value = ""; // reset it/clear it when page loads
</script>

<style>
  .search-bar-holder {
    padding: 1rem 0;
    display: flex;
    justify-content: left;
    width: 100%;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .describing-limits {
    padding: 0 0 1rem 0;
    font-size: 0.9rem;
  }
  .toggle-holder {
    font-size: 0.9rem;
  }
  .list-holder {
    padding: 1rem 0;
  }
</style>
