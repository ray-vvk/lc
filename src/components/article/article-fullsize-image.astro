---
import { Image } from "astro:assets";
interface Props {
  figSrc: ImageMetadata;
  figCaption: HTMLElement;
  figAlt: string;
}
const { figSrc, figAlt, figCaption } = Astro.props;
---

<figure>
  <Image src={figSrc} loading="lazy" alt={figAlt} />
  <figcaption>
    {figCaption}
  </figcaption>
</figure>
