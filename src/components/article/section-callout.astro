---
import ArticleCallout from "./article-callout.astro";
---

<section>
  <div class="wrap">
    <div>
      <h2>Section with a callout</h2>
      <slot name="before-callout" />
      <ArticleCallout>
        <div slot="callout-contents">
          <div>this goes into the callout.</div>
          <div>multiple divs.</div>
        </div>
      </ArticleCallout>
      <slot name="after-callout" />
    </div>
  </div>
</section>

