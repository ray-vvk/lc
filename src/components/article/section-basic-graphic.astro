---
import owl from "../../images/placeholder_owl.jpg";
import ArticleFullsizeImage from "./article-fullsize-image.astro";
interface Props {
  h2: string;
  figSrc: ImageMetadata;
  figCaption: HTMLElement;
  figAlt: string;
}
const { h2 } = Astro.props;
---

<section>
  <div class="wrap">
    <h2>{h2}</h2>
    <slot name="before-graphic" />
    <ArticleFullsizeImage
      figSrc={owl}
      figAlt="owl"
      figCaption={(<>this is an owl.</>)}
    />
    <slot name="after-graphic" />
  </div>
</section>

