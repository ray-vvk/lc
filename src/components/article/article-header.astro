---
interface Props {
  title: (() => HTMLElement) | string;
  subtitle: (() => HTMLElement) | string;
  category: (() => HTMLElement) | string;
  tags: string[];
}
const { title, subtitle, category, tags } = Astro.props;
let title_;
let subtitle_;
let category_;
if (typeof title === "function") {
  title_ = title()
} else {
  title_ = title 
}
if (typeof subtitle === "function") {
  subtitle_ = subtitle()
} else {
  subtitle_ = subtitle 
}
if (typeof category === "function") {
  category_ = category()
} else {
  category_ = category 
}
---

<header>
  <div class="wrap">
    <div class="eyebrow">{category_}</div>
    <h1>{title_}</h1>
    <p class="dek">{subtitle_}</p>
    <div class="tags">
      Tags: &nbsp;
      {
        tags.map((tag, i, tags) => {
          if (i !== tags.length - 1) {
            return (
              <span>
                <a href={`/lc/tags/${tag}`}>{tag}</a>,&nbsp;
              </span>
            );
          }
          return (
            <span>
              <a href={`/lc/tags/${tag}`}>{tag}</a>
            </span>
          );
        })
      }
    </div>
  </div>
</header>

<style>
  .tags {
    font-size: 0.94rem;
    font-weight: bold;
    a {
      text-transform: uppercase;
    }
  }
</style>
