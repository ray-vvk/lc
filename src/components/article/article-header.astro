---
interface Props {
  title: string;
  subtitle: string;
  // category: string;
  tags: string[];
  pubDate: string;
  updatedDate: string;
  keywords?: string[];
}
const { title, subtitle, tags, pubDate, updatedDate, keywords } = Astro.props;

/**
 * output keywords nicely
 * @param keywords 
 */
function keywordsFunction(keywords: string[] | undefined) {
  let k = "Keywords: ";
  if (keywords) {
    for (let i = 0; i < keywords.length; i++) {
      if (i === keywords.length - 1) {
        k += keywords[i];
      } else {
        k += keywords[i] + ", ";
      }
    }
    return k;
  }
  return null;
}
---

<header>
  <div class="wrap">
    <!-- <div class="eyebrow">{category}</div> -->
    <h1>{title}</h1>
    <p class="dek">{subtitle}</p>
    <p class="dates">
      Date published: {pubDate.slice(0, 10)}
      <br />Date updated: {updatedDate.slice(0, 10)}
    </p>
    <div class="tags">
      Tags: &nbsp;
      {
        tags.map((tag, i, tags) => {
          if (i !== tags.length - 1) {
            return (
              <span>
                <a href={`/lc/tags/${tag}`}>{tag}</a>,&nbsp;
              </span>
            );
          }
          return (
            <span>
              <a href={`/lc/tags/${tag}`}>{tag}</a>
            </span>
          );
        })
      }
    </div>
    <div class="keywords">
      {keywordsFunction(keywords)}
      <div></div>
      {
        keywords ? 
        keywords.map((keyword, i, keywords) => {
          return i === keywords.length-1 ? keyword : `${keyword}, `
        })
        : null
      }
    </div>
  </div>
</header>

<style>
  .tags {
    font-size: 0.94rem;
    font-weight: bold;
    a {
      text-transform: uppercase;
    }
  }
  .dates {
    font-size: 0.96rem;
  }
  .keywords {
    padding-top: 1rem;
    font-style: italic;
    font-size: 0.93rem;
    color: var(--muted);
  }
</style>
