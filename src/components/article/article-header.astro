---
interface Props {
  title: string;
  subtitle: string;
  // category: string;
  tags: string[];
  pubDate: string;
  updatedDate: string;
}
const { title, subtitle, tags, pubDate, updatedDate } = Astro.props;
---

<header>
  <div class="wrap">
    <!-- <div class="eyebrow">{category}</div> -->
    <h1>{title}</h1>
    <p class="dek">{subtitle}</p>
    <p class="dates">
      Date published: {pubDate.slice(0, 10)}
      <br />Date updated: {updatedDate.slice(0, 10)}
    </p>
    <div class="tags">
      Tags: &nbsp;
      {
        tags.map((tag, i, tags) => {
          if (i !== tags.length - 1) {
            return (
              <span>
                <a href={`/lc/tags/${tag}`}>{tag}</a>,&nbsp;
              </span>
            );
          }
          return (
            <span>
              <a href={`/lc/tags/${tag}`}>{tag}</a>
            </span>
          );
        })
      }
    </div>
  </div>
</header>

<style>
  .tags {
    font-size: 0.94rem;
    font-weight: bold;
    a {
      text-transform: uppercase;
    }
  }
  .dates {
    font-size: 0.96rem;
  }
</style>
