---
import { Image } from "astro:assets";
interface Props {
  h2: string 
  figSrc: ImageMetadata
  figCaption: HTMLElement | string 
  figAlt: string
}
const { h2, figSrc, figAlt, figCaption } = Astro.props;
---

<section>
  <div class="wrap grid">
    <div>
      <h2>{h2}</h2>
      <slot />
    </div>
    <aside>
      <figure>
        <Image src={figSrc} loading="lazy" alt={figAlt} />
        <figcaption>
          {figCaption}
        </figcaption>
      </figure>
    </aside>
  </div>
</section>
