---
import { getCollection } from "astro:content";
import { sortRecentFirst } from "../lib/article/article-helper-functions";

const articleData = sortRecentFirst(await getCollection("articleData"));
interface Props {
  maxArticles: number;
}
const { maxArticles } = Astro.props;
---

<div>
  <p>Recent articles:</p>
  <ul>
    {
      // sort by recent pubDate first. so oldest pubDate last.
      articleData
        .map((article) => {
          return (
            <li>
              <a href={`/lc/articles/${article.id}`}>{article.data.title}</a>
            </li>
          );
        })
        .slice(0, maxArticles)
    }
  </ul>
</div>

<style>
  ul {
    list-style-type: "—  ";
    padding-left: 2rem;
  }
</style>
