---
// @ts-ignore
import Papa from "papaparse";
import fs from "fs/promises";
import PublicationsTBody from "./publications-tbody";
// const file = fs.createReadStream('src/components/publications/publications-2026-09-17.csv')
const file = await fs.readFile(
  "src/components/publications/publications-2026-09-17.csv",
  "utf-8",
);
const fileString = file.toString();
const parseResult = Papa.parse(fileString, {
  header: true,
});
const data: {
  "Article:": string;
  "Link:": string;
  "Year Published:": string;
  "Lot Number:": string;
  "Summary:": string;
}[] = parseResult.data;
const dataSortedMostRecent = data.sort((a1, a2) => {
  if (!a1["Year Published:"] || !a2["Year Published:"]) return 1;
  if (a1["Year Published:"] < a2["Year Published:"]) return 1;
  if (a1["Year Published:"] > a2["Year Published:"]) return -1;
  return 0;
});
interface Props {
  count: number;
}
const { count } = Astro.props;
// if count is present, randomly select count # of articles to display by removing others.
---

<div class="table-overflower">
  <table class="comparison">
    <thead>
      <tr>
        <th>Publication title</th>
        <th class="year-published">Year published</th>
      </tr>
    </thead>
    <tbody>
      <PublicationsTBody count={count} publicationData={data} />
    </tbody>
  </table>
</div>

<style>
  th.year-published {
    min-width: 11rem;
  }
</style>
