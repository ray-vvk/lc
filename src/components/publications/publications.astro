---
// @ts-ignore
import Papa from "papaparse";
import fs from "fs/promises";
// const file = fs.createReadStream('src/components/publications/publications-2026-09-17.csv')
const file = await fs.readFile(
  "src/components/publications/publications-2026-09-17.csv",
  "utf-8",
);
const fileString = file.toString();
const parseResult = Papa.parse(fileString, {
  header: true,
});
const data: {
  "Article:": string;
  "Link:": string;
  "Year Published:": string;
  "Lot Number:": string;
  "Summary:": string;
}[] = parseResult.data;
const dataSortedMostRecent = data.sort((a1, a2) => {
  if (!a1["Year Published:"] || !a2["Year Published:"]) return 1;
  if (a1["Year Published:"] < a2["Year Published:"]) return 1;
  if (a1["Year Published:"] > a2["Year Published:"]) return -1;
  return 0;
});
interface Props {
  count: number;
}
const { count } = Astro.props;
// if count is present, randomly select count # of articles to display by removing others.
if (count) {
  const removeNumber = dataSortedMostRecent.length - count;
  for (let i = 0; i < removeNumber; i++) {
    const length = dataSortedMostRecent.length;
    const r = Math.floor(Math.random() * length);
    dataSortedMostRecent.splice(r, 1);
  }
}
---

<div class="table-overflower">
  <table class="comparison">
    <thead>
      <tr>
        <th>Publication title</th>
        <th class="year-published">Year published</th>
      </tr>
    </thead>
    <tbody>
      {
        dataSortedMostRecent.map((c) => {
          const articleTitle = c["Article:"];
          const articleLink = c["Link:"];
          const articleYear = c["Year Published:"]
            ? c["Year Published:"]
            : "N/A";

          return (
            <tr>
              <td>
                {articleLink.includes("https") ? (
                  <div class="publication publication-link">
                    <a
                      target="_blank"
                      rel="noopener noreferrer"
                      href={articleLink}
                    >
                      {articleTitle}
                    </a>
                  </div>
                ) : (
                  <div class="publication">
                    <span>{articleTitle}</span>
                  </div>
                )}
              </td>
              <td>{articleYear}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

<style>
  .publication {
    font-family: serif;
  }
  .publication-link {
    transition-duration: 500ms;
  }
  .publication-link:hover {
    transform: scale(1.01);
  }
  th.year-published {
    min-width: 11rem;
  }
</style>
