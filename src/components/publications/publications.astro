---
// @ts-ignore
import Papa from "papaparse";
import fs from "fs/promises";
import PublicationsTable from "./publications-table";
const file = await fs.readFile(
  "src/components/publications/publications-2026-09-17.csv",
  "utf-8",
);
const fileString = file.toString();
const parseResult = Papa.parse(fileString, {
  header: true,
});
const data: {
  "Article:": string;
  "Link:": string;
  "Year Published:": string;
  "Lot Number:": string;
  "Summary:": string;
}[] = parseResult.data;
const dataSortedMostRecent = data.sort((a1, a2) => {
  if (!a1["Year Published:"] || !a2["Year Published:"]) return 1;
  if (a1["Year Published:"] < a2["Year Published:"]) return 1;
  if (a1["Year Published:"] > a2["Year Published:"]) return -1;
  return 0;
});
interface Props {
  count: number;
}
const { count } = Astro.props;
// if count is present, randomly select count # of articles to display by removing others.
---

<div class="table-overflower">
  <PublicationsTable client:only="react" count={count} publicationData={dataSortedMostRecent} />
  <div slot="fallback">Loading...</div>
</div>
