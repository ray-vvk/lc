<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Mozilla+Headline:wght@200..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");

  :root {
    /* --navy: #08245c; */
    /* --blue: #0a62b8; */
    --cyan: #50baeb;
    --green: #3a8d22;
    --ink: #15203b;
    --muted: #526075;
    --line: #d9e2ef;
    --pale: #f5f8fc;
    --white: #fff;
    --max: 1080px;

    --light-blue: #0072bb;
    --dark-blue: #002060;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    line-height: 1.65;
    background: #fff;
    font-size: 1.1rem;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: var(--light-blue);
  }

  .wrap {
    width: min(var(--max), 92vw);
    margin: auto;
  }

  .topbar {
    background: var(--dark-blue);
    color: #fff;
    padding: 0.65rem 0;
    font-size: 0.93rem;
    height: 4rem;

    .logo-and-name {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .virovek-logo-div {
      width: 7rem;
    }

    .wrap {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      height: 100%;

      .links {
        display: flex;
        gap: 2rem;
      }
    }

    .links.mobile-menu-hidden {
      display: none;
    }

    a {
      color: #fff;
      text-decoration: none;
    }
  }

  .hamburger .hamburger-box {
    display: none;
  }

  header {
    padding: 3.2rem 0 2rem;
    background: linear-gradient(180deg, #f8fbff 0%, #fff 100%);
  }

  .eyebrow {
    font-weight: 700;
    color: var(--light-blue);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family:
      Mozilla Headline,
      IBM Plex Sans,
      sans-serif;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.3rem);
    line-height: 1.06;
    margin: 0.45rem 0 1rem;
    color: var(--dark-blue);
    max-width: 980px;
  }

  main {
    min-height: 75vh;
  }

  .dek {
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    max-width: 890px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 1.7rem 0 0;
  }

  .btn {
    display: inline-block;
    border-radius: 7px;
    padding: 0.88rem 1.15rem;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--light-blue);
  }

  .btn.primary {
    background: var(--light-blue);
    color: #fff;
  }

  .btn.secondary {
    background: #fff;
    color: var(--light-blue);
  }

  .hero-figure {
    margin: 2rem auto 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(7, 37, 87, 0.12);
  }

  main section {
    padding: 4.2rem 0;
    border-top: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.75fr);
    gap: 3rem;
    align-items: start;
  }

  .section-label {
    color: var(--light-blue);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.15;
    margin: 0.35rem 0 1rem;
    color: var(--dark-blue);
  }

  h3 {
    color: var(--dark-blue);
    font-size: 1.28rem;
    margin-top: 1.8rem;
  }

  p {
    margin: 0.8rem 0;
  }

  .lead {
    font-size: 1.15rem;
    color: #38465c;
  }

  figure {
    margin: 1.6rem 0 0;
  }

  figure img {
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(7, 37, 87, 0.08);
  }

  figcaption {
    font-size: 0.94rem;
    color: var(--muted);
    margin: 0.75rem 0.25rem;
    margin-bottom: 1.4rem;
  }

  .callout {
    border-left: 5px solid var(--cyan);
    background: #eefaff;
    padding: 1rem 1.2rem;
    border-radius: 5px;
    margin: 1.35rem 0;
  }

  .question {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dark-blue);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    margin-top: 1.4rem;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.2rem;
    background: #fff;
  }

  .card h3 {
    margin: 0.1rem 0 0.5rem;
    font-size: 1.12rem;
  }

  .comparison {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0;
  }

  .comparison th,
  .comparison td {
    border: 1px solid var(--line);
    padding: 0.8rem;
    vertical-align: top;
    text-align: left;
  }

  .comparison th {
    background: var(--pale);
    color: var(--dark-blue);
  }

  .table-overflower {
    overflow: scroll;
  }

  .cta {
    background: linear-gradient(135deg, var(--dark-blue), var(--light-blue));
    color: #fff;
    border-radius: 16px;
    padding: 2rem;
    margin-top: 2rem;
  }

  .cta h2,
  .cta h3 {
    color: #fff;
  }

  .cta a {
    color: #fff;
  }

  .cta .btn.secondary {
    border-color: #fff;
    background: #fff;
    color: var(--dark-blue);
  }

  .references {
    font-size: 0.93rem;
  }

  footer {
    background: #061d4b;
    color: #dce8ff;
    padding: 2.2rem 0;
    font-size: 0.9rem;

    img {
      max-width: 12rem;
    }
  }

  .footer-flex-left {
    display: flex;
    gap: 2rem;
    padding-bottom: 1rem;
  }

  footer a {
    color: #fff;
  }

  @media (max-width: 1000px) {
    .table-overflower {
      max-width: 92vw;
    }

    .comparison {
      min-width: 60rem;
    }
  }

  @media (max-width: 850px) {
    .hamburger .hamburger-box {
      display: block;
    }

    .topbar {
      position: relative;
    }

    .topbar .wrap {
      .links {
        display: none;
      }

      .links.mobile-menu {
        display: block;
        position: absolute;
        top: 4rem;
        left: 0;
        background-color: var(--dark-blue);
        width: 100%;
        padding-bottom: 2rem;
        text-align: right;

        .wrap {
          display: block;
        }
      }

      .links.mobile-menu-hidden {
        display: none;
      }
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    main section {
      padding: 3rem 0;
    }

    .footer-flex-left {
      display: inline-block;

      .virovek-logo-div {
        padding-bottom: 1rem;
      }
    }
  }
</style>
